<style>
  .sov-map { position: relative; width: 100%; max-width: 540px; margin: 0 auto; }
  .sov-map svg { width: 100%; height: auto; display: block; overflow: visible; }

  .sov-country path {
    fill: rgba(59,130,246,0.08);
    stroke: rgba(147,197,253,0.28);
    stroke-width: 1;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 6px rgba(59,130,246,0.35));
    animation: sov-breathe 6s ease-in-out infinite;
  }
  @keyframes sov-breathe {
    0%,100% { stroke: rgba(147,197,253,0.28); }
    50% { stroke: rgba(59,130,246,0.55); }
  }

  .sov-nodes .n {
    fill: var(--accent-bright);
    filter: drop-shadow(0 0 7px rgba(59,130,246,0.85));
    animation: sov-pulse 3.2s ease-in-out infinite;
    animation-delay: var(--d);
  }
  .sov-nodes .gold { fill: var(--brass); filter: drop-shadow(0 0 9px rgba(245,158,11,0.85)); }
  @keyframes sov-pulse { 0%,100% { opacity: 0.55; } 50% { opacity: 1; } }

  .cross-line { stroke: var(--brass); stroke-width: 1.6; stroke-dasharray: 5 5; opacity: 0.5; }
  .cross-dot { fill: var(--brass); animation: sov-attempt 4.5s ease-in-out infinite; }
  .cross-block { opacity: 0; animation: sov-blockfade 4.5s ease-in-out infinite; }
  @keyframes sov-attempt {
    0%, 42% { transform: translate(0,0); opacity: 1; }
    62% { transform: translate(108px,-38px); opacity: 1; }
    64%, 100% { opacity: 0; transform: translate(108px,-38px); }
  }
  @keyframes sov-blockfade {
    0%, 60% { opacity: 0; }
    66%, 90% { opacity: 1; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sov-country path, .sov-nodes .n, .cross-dot, .cross-block { animation: none; }
    .cross-dot { opacity: 0; }
    .cross-block { opacity: 1; }
  }
</style>
